# ARM U — volucer + spawn_cgi over a UNIX SOCKET.
#
# Identical to `volucer-cgi-tcp.toml.template` except for the transport, which is
# the point: T and U are the same server, the same model and the same SAPI, so a
# difference between them is the transport and nothing else. That pair is how this
# repository answers the question hazard 23 left open — whether the FastCGI arm's
# advantage over a piped worker is the transport or the SAPI.
#
#   socket = "unix:/run/volucer/cgi"   A path PREFIX, not a finished path: slot 0
#                  binds /run/volucer/cgi.0.sock and slot 1 the next, because one
#                  socket per process is what lets a slot be recycled on its own.
#
# `php-cgi -b` treats a bind argument containing no `:` as an AF_UNIX path on any
# non-Windows platform (hazard 26), so this needs no external FastCGI pool. On
# Windows the same argument means a named pipe this backend does not drive, and
# the configuration is rejected at startup rather than silently ignored — which is
# why this arm is Linux/macOS only.
#
# The directory must exist and be writable by the user running volucer. The pool
# unlinks its sockets on shutdown, so a leftover file means a server that was
# killed rather than stopped; `php-cgi` unlinks a stale path itself before binding.

default_backend = "cgi"

[server]
http = "127.0.0.1:{{PORT}}"
document_root = "{{ROOT}}/public"

# The static-file layer is OFF so this arm stays comparable with the five others;
# see the long comment in `volucer-pipe.toml.template`. It is default-on since
# `b9d34c4` and costs ~6.5 us and up to 21.6% on `GET /` on this host, which is a
# cost no other arm here pays.
[server.static_files]
enabled = false

[backends.cgi]
kind = "spawn_cgi"
binary = "{{PHP_CGI}}"
workers = 12
socket = "unix:{{SOCKET_DIR}}/cgi"
max_requests = 0
