{
  "name": "sailantis/volucer-competition",
  "description": "One azera page served five ways: volucer (pipe worker, FastCGI over TCP, FastCGI over a unix socket), RoadRunner, and nginx + php-fpm.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "sailantis/azera-framework": "v0.3.1",
    "sailantis/clarity-engine": "v0.4.1",
    "sailantis/volucer-worker": "v0.4.1",
    "spiral/roadrunner-worker": "^3.5",
    "spiral/roadrunner-http": "^3.5",
    "nyholm/psr7": "^1.8"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/sailantis/azera-framework.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/sailantis/clarity-engine.git",
      "no-api": true
    },
    {
      "type": "vcs",
      "url": "https://github.com/sailantis/volucer-php-sdk.git",
      "no-api": true
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\Azera\\": "apps/azera/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
